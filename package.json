{
  "name": "customizable-dca-openhands",
  "version": "0.0.1",
  "description": "Customizable DCA — a customizable, local-first web IDE for driving OpenHands coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoncheng57/Customizable-DCA-OpenHands.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:demo": "VITE_DEMO=1 VITE_BASE_PATH=/Customizable-DCA-OpenHands/ vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @shots",
    "screenshots": "tsx scripts/shots-manifest.ts && playwright test --grep @shots"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.0.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
