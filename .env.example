# ── LLM ──────────────────────────────────────────────────────────────────────
# Primary key; default models are anthropic/* (haiku/sonnet/opus).
ANTHROPIC_API_KEY=

# Required by the openai/* entries in the model dropdown (GPT-5.6 Luna/Terra/
# Sol) — the agent container only holds the Anthropic key, so the BFF forwards
# these per conversation. NOTE: EU-data-residency keys must use the EU endpoint
# — they 401 against the default api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1

# Comma-separated model allowlist shown in the UI (first = default) — optional.
# OPENHANDS_MODELS=anthropic/claude-sonnet-5,anthropic/claude-haiku-4-5-20251001

# ── Agent server (agent-canvas via docker compose) ───────────────────────────
# scripts/dev.sh starts ghcr.io/openhands/agent-canvas headless on :8010.
OPENHANDS_INTERNAL_URL=http://localhost:8010
# API key auto-generated by agent-canvas at first boot; ./.state is the bind
# mount of the container's /home/openhands/.openhands (gitignored).
OPENHANDS_API_KEY_FILE=./.state/agent-canvas/api-key.txt
# OPENHANDS_API_KEY=            # alternative to the file

# ── Workspaces ───────────────────────────────────────────────────────────────
# Host directory bind-mounted into the agent at /home/openhands/workspace/local
# for local-folder conversations. Absolute path or ~/... (dev.sh expands ~).
OPENHANDS_PROJECTS_DIR=~/Projects

# ── GitHub (optional — lets agents use `gh` and clone/push github.com) ───────
# repo-scope PAT (fine-grained recommended). Tip: `gh auth token` on the host
# prints your current CLI token. Exposed to the agent as GH_TOKEN/GITHUB_TOKEN
# — note this grants agents write access to whatever the token can reach.
# OPENHANDS_GITHUB_TOKEN=

# ── Git / GitLab (optional — clone workflow, MR panel, suggested issues) ─────
# GITLAB_TOKEN=                 # PRIVATE-TOKEN for the GitLab REST features
# GITLAB_BASE_URL=https://gitlab.com
# OPENHANDS_GIT_TOKEN=          # token the git askpass helper answers with
                                # (falls back to GITLAB_TOKEN)
# Override the repo-URL allowlist (default: gitlab.com + github.com):
# OPENHANDS_REPO_URL_PATTERN=^https://(gitlab\.com|github\.com)/[\w./-]+$

# ── Push notifications (ntfy — https://docs.ntfy.sh) ─────────────────────────
# Subscribe to the topic in the ntfy app; you get pings on finished / error /
# stuck / awaiting-input. Also configurable at runtime from /openhands/notifications.
# OPENHANDS_NTFY_URL=https://ntfy.sh
# OPENHANDS_NTFY_TOPIC=          # pick something unguessable on public servers
# OPENHANDS_NTFY_TOKEN=          # optional Bearer token (self-hosted servers)
# OPENHANDS_NOTIFY_IDLE=1

# ── App ──────────────────────────────────────────────────────────────────────
# :3000 is commonly taken (e.g. other dev stacks) — the vite proxy follows PORT.
PORT=3000
# Single-user local default; oauth2-proxy-compatible if fronted.
OPENHANDS_ALLOWED_EMAILS=dev@local

# Remote access (e.g. from your phone over Tailscale): Vite rejects dev-server
# requests whose Host header isn't allowlisted (DNS-rebinding protection).
# Add your tailnet hostname (comma-separated list, or "all" to accept any
# host) and open http://<machine>.<tailnet>.ts.net:5173 on the phone.
# `tailscale status --json | jq -r .Self.DNSName` prints the hostname.
# VITE_ALLOWED_HOSTS=your-machine.your-tailnet.ts.net

# ── Manager runs (optional — enables the postgres compose profile) ───────────
# PGHOST=localhost
# PGPORT=55432
# PGDATABASE=openhands
# PGUSER=openhands
# PGPASSWORD=openhands

# ── Atlassian (optional — lets agents use acli for Jira/Confluence) ──────────
# API token from id.atlassian.com; dev.sh performs the acli login.
# ATLASSIAN_SITE=yoursite.atlassian.net
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=

# ── Notion (optional — lets agents use the Notion CLI, ntn) ─────────────────
# Internal integration token (ntn_…) from notion.so/profile/integrations,
# shared with the pages/databases agents should reach. scripts/dev.sh installs
# ntn inside the agent container; the CLI reads NOTION_API_TOKEN directly.
# NOTION_API_TOKEN=

# ── Agent MCP servers ────────────────────────────────────────────────────────
# Copy mcp-servers.example.json → mcp-servers.json (gitignored) and dev.sh
# syncs it into agent settings. Health shows on /openhands/tools.
