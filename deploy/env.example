# Configuration for the packaged app (deploy/compose.yaml).
# deploy/install.sh creates .env from this file and fills in the two
# required values below.

# ── Required ─────────────────────────────────────────────────────────────────
# LLM key; default models are anthropic/* (haiku/sonnet/opus).
ANTHROPIC_API_KEY=

# Host directory with your project folders (ABSOLUTE path — compose does not
# expand ~). Local-folder conversations pick from its subdirectories.
OPENHANDS_PROJECTS_DIR=

# ── App ──────────────────────────────────────────────────────────────────────
# Host port for the UI+API (http://localhost:3000 by default).
# PORT=3000
# Loopback-only by default. 0.0.0.0 exposes the app on your LAN — anyone who
# can reach the port has full access (single-user identity fallback).
# OPENHANDS_BIND=127.0.0.1
# Pin a released version instead of latest (e.g. 0.2.0), or override the image.
# OPENHANDS_APP_VERSION=latest
# OPENHANDS_APP_IMAGE=ghcr.io/leoncheng57/customizable-dca-openhands

# ── Optional LLM extras ──────────────────────────────────────────────────────
# Needed by the openai/* entries in the model dropdown. NOTE: EU-data-residency
# keys must use the EU endpoint — they 401 against the default api.openai.com.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://eu.api.openai.com/v1
# Comma-separated model allowlist shown in the UI (first = default).
# OPENHANDS_MODELS=anthropic/claude-sonnet-5,anthropic/claude-haiku-4-5-20251001

# ── GitHub / GitLab (optional — clone workflow, gh/glab inside the agent) ────
# OPENHANDS_GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com
# OPENHANDS_GIT_TOKEN=
# OPENHANDS_REPO_URL_PATTERN=^https://(gitlab\.com|github\.com)/[\w./-]+$

# ── Push notifications (ntfy — https://docs.ntfy.sh) ─────────────────────────
# OPENHANDS_NTFY_URL=https://ntfy.sh
# OPENHANDS_NTFY_TOPIC=
# OPENHANDS_NTFY_TOKEN=
# OPENHANDS_NOTIFY_IDLE=1

# ── Manager runs (optional — starts the bundled postgres) ────────────────────
# COMPOSE_PROFILES=manager
# PGHOST=postgres
